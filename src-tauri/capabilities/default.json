{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["overlay", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "store:default",
    "autostart:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex/**" },
        { "path": "$TEMP" },
        { "path": "$TEMP/claude-statusline-*/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.anthropic.com/*" }, { "url": "https://chatgpt.com/*" }]
    }
  ]
}
