{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Monitor",
  "version": "0.1.0",
  "identifier": "dev.patrickiel.usage-monitor",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Usage Overlay",
        "width": 300,
        "height": 40,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Usage Monitor",
        "width": 380,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false }
  }
}
