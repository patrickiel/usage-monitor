{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Monitor",
  "version": "0.3.0",
  "identifier": "dev.patrickiel.usage-monitor",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Usage Overlay",
        "width": 300,
        "height": 40,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Usage Monitor",
        "width": 760,
        "height": 500,
        "minWidth": 360,
        "minHeight": 320,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "patrickiel",
    "shortDescription": "Claude Code and Codex usage limits on your taskbar",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzRDQ5RjlFMThGN0Q4NzgKUldSNDJQY1lucC9VbzNCWmZQOWRUYTRLeTZ3cGxHbk5UUDBEQkViSzRtMGFuMWUzdlA3KzFwaTQK",
      "endpoints": ["https://github.com/patrickiel/usage-monitor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
